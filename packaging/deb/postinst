#!/bin/sh
# stallo postinst: the system user, then the network table and the daemon.
set -e

case "$1" in
configure)
	if ! getent passwd stallo >/dev/null; then
		# A group without the user is someone else's: its members would
		# get the full API.
		if getent group stallo >/dev/null; then
			echo "stallo: group stallo exists without user stallo; refusing (remove or rename it first)" >&2
			exit 1
		fi
		# No login, no home of its own; /dev/kvm comes from the unit's
		# SupplementaryGroups=kvm, not from /etc/group.
		useradd --system --user-group --home-dir /var/lib/stallo \
			--no-create-home --shell /usr/sbin/nologin \
			--comment "Stallo VM daemon" stallo
	fi
	# Never adopt a human account: the daemon and the network table would
	# then apply to it.
	uid=$(id -u stallo)
	if [ "$uid" -ge 1000 ] || [ "$uid" = 0 ]; then
		echo "stallo: user stallo exists but is not a system user (uid $uid); refusing" >&2
		exit 1
	fi
	;;
abort-upgrade | abort-deconfigure | abort-remove) ;;
*) exit 0 ;;
esac

if [ -d /run/systemd/system ]; then
	systemctl daemon-reload >/dev/null || true
fi
for unit in stallo-nft.service stallod.service; do
	# Only lifts the mask that postrm set on removal.
	deb-systemd-helper unmask "$unit" >/dev/null || true
	# Enable on first install; later, keep the owner's choice.
	if deb-systemd-helper --quiet was-enabled "$unit"; then
		deb-systemd-helper enable "$unit" >/dev/null || true
	else
		deb-systemd-helper update-state "$unit" >/dev/null || true
	fi
done
if [ -d /run/systemd/system ]; then
	# The table first: stallod refuses `internet` VMs without it. prerm
	# stopped the daemon, so this also brings it back after a failed
	# upgrade (abort-upgrade).
	deb-systemd-invoke restart stallo-nft.service >/dev/null || true
	deb-systemd-invoke start stallod.service >/dev/null || true
fi
members=$(getent group stallo | cut -d: -f4)
echo "stallo: members of group stallo (full API access): ${members:-none}"
exit 0
